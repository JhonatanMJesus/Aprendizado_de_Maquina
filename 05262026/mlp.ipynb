    "    # Para plotar o gráfico do limiar de decisão\n",
    "    def plot_decision_boundary(self, X, y, step=0.02): \n",
    "        if X.shape[1] != 2:\n",
    "            print(\"A fronteira de decisão só pode ser plotada para dados 2D\")\n",
    "            return\n",
    "        \n",
    "        #Criar grid - funciona quase igual o Perceptron aqui\n",
    "        x_min, x_max = X[:, 0].min() - 0.1, X[:, 0].max() + 0.1\n",
    "        y_min, y_max = X[:, 1].min() - 0.1, X[:, 1].max() + 0.1\n",
    "        xx, yy = np.meshgrid(np.arange(x_min, x_max, step), np.arange(y_min, y_max, step))\n",
    "\n",
    "         # Predição para cada ponto da grade\n",
    "        grid_points = np.c_[xx.ravel(), yy.ravel()]\n",
    "\n",
    "        # Prever para o grid\n",
    "        predictions = self.predict(grid_points).reshape(xx.shape)\n",
    "\n",
    "        # Plotar\n",
    "        plt.contourf(xx, yy, predictions, alpha=0.7)\n",
    "        plt.scatter(X[:, 0], X[:, 1], c=y, edgecolors='k', marker='o')\n",
    "        plt.title('Fronteira de Decisão')\n",
    "        plt.show()\n",
