    "# Dataset de Treinamento\n",
    "data = np.genfromtxt('train_dataset.csv', delimiter=',', skip_header=1)\n",
    "X_train = data[:, :-1] # Features\n",
    "y_train = data[:, -1] # Labels\n",
    "y_train = (y_train + 1) // 2 # Converte os rótulo do perceptron (1 e -1) para um formato que o Pytorch espera (0 e 1)\n",
    "\n",
    "# Dataset de Teste\n",
    "data = np.genfromtxt('test_dataset.csv', delimiter=',', skip_header=1)\n",
    "X_test = data[:, :-1] # Features\n",
    "y_test = data[:, -1] # Labels\n",
    "y_test = (y_test + 1) // 2\n",
    "\n",
    "# Criar e treinar o modelo passando os parâmetros necessários\n",
    "mlp = MLPClassifier(\n",
    "    optimizer='adam',\n",
    "    learning_rate=0.001,\n",
    "    hidden_layers=[50, 128, 64, 4],\n",
    "    activation='relu',\n",
    "    regularization='dropout',\n",
    "    dropout_p=0.1\n",
    ")\n",
    "\n",
    "# Treinar o modelo\n",
    "mlp.fit(X_train, y_train)\n",
    "\n",
    "# Avaliar no conjunto de teste\n",
    "test_acc = mlp.evaluate(X_test, y_test)\n",
    "print(f\"\\nAcurácia do Teste: {test_acc*100:.2f}%\")\n",
    "\n",
    "# Plotar histórico de treinamento\n",
    "mlp.plot_training_history()\n",
    "\n",
    "# Plotar fronteira de decisão (apenas para os dados 2D)\n",
    "mlp.plot_decision_boundary(X_train, y_train)\n",
    "\n",
    "mlp.predict(X_test)\n",
    "mlp.plot_decision_boundary(X_test, y_test)"
